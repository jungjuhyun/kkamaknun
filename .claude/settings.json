{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python tools/harness/hook_session_start.py" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python tools/harness/hook_prompt.py" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell", "hooks": [ { "type": "command", "command": "python tools/harness/hook_guard.py" } ] }
    ]
  }
}
